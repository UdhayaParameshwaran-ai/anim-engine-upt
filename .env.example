# Copy to .env (gitignored) and fill in. Only the providers you use need a key.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Azure OpenAI: the resource endpoint (…openai.azure.com/openai), key and deployment name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# Deployments to offer in the Studio model menu (Azure cannot list them):
# AZURE_OPENAI_DEPLOYMENTS=gpt-4.1,gpt-5.4-nano,gpt-5-mini

# Google Gemini (OpenAI-compatible endpoint).
GEMINI_API_KEY=
# ANIM_GEMINI_MODEL=gemini-3-flash-preview   (the Studio menu lists every model the key can use)

# Claude on your own Claude subscription (provider `claude`): no key here. It runs the
# Claude Code CLI headless, so install it and log in once with `claude`. Calls count
# against the subscription's usage limits. ANTHROPIC_API_KEY is never passed to it.
# ANIM_CLAUDE_MODEL=claude-opus-5-5     (or claude-sonnet-5-5 for faster, lighter use)
# ANIM_CLAUDE_BIN=claude                (path to the CLI if it is not on PATH)

# Optional: provider order (first is primary, the rest are fallbacks) and models.
# ANIM_LLM_PROVIDERS=claude,azure,gemini   (default: openrouter,azure,gemini,groq)
# ANIM_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# ANIM_GROQ_MODEL=openai/gpt-oss-120b

# Narration voice for the Studio: kokoro (local neural TTS, default) or beeps (instant mock).
# ANIM_TTS=kokoro
