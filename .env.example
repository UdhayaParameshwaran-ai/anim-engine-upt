# Copy to .env (gitignored) and fill in. Only the providers you use need a key.
OPENROUTER_API_KEY=

# Claude API (pay-per-token key from console.anthropic.com).
ANTHROPIC_API_KEY=
# ANIM_ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini (OpenAI-compatible endpoint).
GEMINI_API_KEY=
# ANIM_GEMINI_MODEL=gemini-3-flash-preview   (the Studio menu lists every model the key can use)

# Claude on your own Claude subscription (provider `claude`): no key here. It runs the
# Claude Code CLI headless, so install it and log in once with `claude`. Calls count
# against the subscription's usage limits. ANTHROPIC_API_KEY is never passed to it (it is only used by the `anthropic` provider).
# ANIM_CLAUDE_MODEL=claude-opus-5-5     (or claude-sonnet-5-5 for faster, lighter use)
# ANIM_CLAUDE_BIN=claude                (path to the CLI if it is not on PATH)

# Optional: provider order (first is primary, the rest are fallbacks) and models.
# ANIM_LLM_PROVIDERS=claude,gemini   (default: openrouter,gemini,anthropic)
# ANIM_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Narration voice for the Studio: piper (local, fast, default), kokoro (local neural TTS, best voice) or beeps (instant mock).
# ANIM_TTS=piper
# Kokoro uses every CPU core by default. On a shared machine give it fewer (4 used under half the CPU time of 16 for the same speech):
# ANIM_KOKORO_THREADS=4

# Hosted Studio (Cloudflare tunnel): set a password and everything sits behind a login page.
# ANIM_PASSWORD=
