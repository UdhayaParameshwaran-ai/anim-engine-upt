{
  "name": "anim-engine-upt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Prompt-to-explainer-video engine: LLM writes a narration-first DSL; the engine resolves timing against TTS and renders SVG/HTML animation live or to video.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && node packages/compiler/dist/cli.js",
    "studio": "vite --config apps/studio/vite.config.ts",
    "preview": "vite --config apps/studio/vite.config.ts",
    "render": "tsc -b && node apps/render/dist/cli.js",
    "generate": "tsc -b && node packages/llm/dist/cli.js"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vite": "^8.3.2",
    "vitest": "^3.0.0"
  }
}
